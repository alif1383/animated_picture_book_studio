{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "mp4-muxer": ["./vendor/mp4-muxer/mp4-muxer.d.ts"],
      "vitest": ["./vendor/vitest-shim/index.d.ts"],
      "isomorphic-git": ["./vendor/isomorphic-git/index.d.ts"]
    }
  },
  "include": ["src", "tests", "vendor/node-shim.d.ts"]
}
